<Window x:Class="events.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberK"
        Height="650"
        Width="1000"
        MinHeight="550"
        MinWidth="850"
        Background="#FFF8E7"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="NavyBlue" Color="#0B1F3A"/>
        <SolidColorBrush x:Key="CreamWhite" Color="#FFF8E7"/>
        <SolidColorBrush x:Key="LightCream" Color="#F5EEDC"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#0B1F3A"/>
            <Setter Property="Foreground" Value="#FFF8E7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFDF5"/>
            <Setter Property="Foreground" Value="#0B1F3A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#B8A989"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="#0B1F3A"
                Padding="12">

            <StackPanel>
                <TextBlock Text="CyberK"
                           Foreground="#FFF8E7"
                           FontSize="28"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,15,0,8"/>

                <TextBlock Text="Cybersecurity Awareness"
                           Foreground="#E7DCC4"
                           FontSize="12"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                <Button Content="Find Topics"
                        Click="FindTopicsButton_Click"
                        Margin="4,5,4,12"/>

                <ScrollViewer MaxHeight="440"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TopicsPanel"
                                Visibility="Collapsed"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1"
              Background="#FFF8E7"
              Margin="12">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#F5EEDC"
                    Padding="15"
                    CornerRadius="8"
                    Margin="0,0,0,10">

                <StackPanel>
                    <TextBlock Text="Welcome to CyberK"
                               Foreground="#0B1F3A"
                               FontSize="22"
                               FontWeight="Bold"/>

                    <TextBlock Text="Your cybersecurity awareness assistant."
                               Foreground="#45556A"
                               FontSize="13"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- CHAT -->
            <Border Grid.Row="1"
                    Background="#F5EEDC"
                    BorderBrush="#D8C9A7"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,0,10">

                <ScrollViewer x:Name="ChatScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel x:Name="ChatPanel"/>
                </ScrollViewer>
            </Border>

            <!-- INPUT -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageInput"
                         Grid.Column="0"
                         Height="45"
                         VerticalContentAlignment="Center"
                         ToolTip="Type your message"
                         KeyDown="MessageInput_KeyDown"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send"
                        Width="85"
                        Height="45"
                        Margin="8,0,0,0"
                        Click="SendButton_Click"/>
            </Grid>

            <!-- CHAT OPTIONS -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0">
                    <Button Content="Clear Chat"
                            Click="ClearButton_Click"/>

                    <Button Content="Chat History"
                            Click="HistoryButton_Click"/>

                    <Button Content="Random Tip"
                            Click="RandomTipButton_Click"/>
                </WrapPanel>

                <Border Grid.Row="1"
                        Background="#0B1F3A"
                        CornerRadius="6"
                        Padding="10"
                        Margin="4,8,4,0">

                    <TextBlock x:Name="TipText"
                               Text="Security tip: Never share your passwords."
                               Foreground="#FFF8E7"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
